{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" },
    "Console": { "IncludeScopes": true }
  },
  "AllowedHosts": "*",

  "Hitl": {
    "BaseUrl": "https://YOUR-PUBLIC-HOST",
    "ConnectionString": "Data Source=hitl.db;Default Timeout=30",
    "StoreRawPayload": false,
    "SchedulerIntervalSeconds": 60,
    "SendRetryBaseDelayMs": 1000,
    "EnableDemo": false,
    "ApiKey": ""
  },

  "Channels": {
    "Teams": {
      "MicrosoftAppType": "SingleTenant",
      "MicrosoftAppId": "",
      "MicrosoftAppPassword": "",
      "MicrosoftAppTenantId": ""
    },
    "Slack": {
      "BotToken": "",
      "SigningSecret": ""
    },
    "WhatsApp": {
      "AccessToken": "",
      "PhoneNumberId": "",
      "AppSecret": "",
      "VerifyToken": "",
      "ApiVersion": "v20.0"
    },
    "Telegram": {
      "BotToken": "",
      "WebhookSecret": "",
      "AutoRegisterWebhook": false
    },
    "Email": {
      "Provider": "Smtp",
      "FromAddress": "hitl@example.com",
      "FromName": "HITL Relay",
      "LinkSigningKey": "",
      "InboundAddressPattern": "",
      "InboundSecret": "",
      "Smtp": { "Host": "", "Port": 587, "UseStartTls": true, "User": "", "Password": "" },
      "Graph": { "TenantId": "", "ClientId": "", "ClientSecret": "", "SenderUser": "" }
    }
  }
}
